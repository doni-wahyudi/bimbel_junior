{
  "name": "bimbel_junior",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node -e \"require('fs').copyFileSync('dist/index.html', 'dist/404.html')\"",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "convert": "python -c \"from PIL import Image; Image.open('public/images/teacher/sisca.jpeg').save('public/images/teacher/sisca.webp', 'webp'); Image.open('public/images/teacher/ofchan.jpeg').save('public/images/teacher/ofchan.webp', 'webp')\""
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1"
  }
}
